# Copy this file to .env, then append BLOG_AUTH_SECRET (see README).
APP_PORT=8090
KAFKA_PORT=9094
MONGO_PORT=27017
# Match the existing data directory's featureCompatibilityVersion (8.2).
MONGO_IMAGE=docker.io/library/mongo:8.2
# Optional absolute paths; defaults are $HOME/kafkadata and $HOME/mongodbdata.
# KAFKA_DATA_DIR=/home/feca/kafkadata
# MONGO_DATA_DIR=/home/feca/mongodbdata
# For an existing KRaft directory, use its meta.properties cluster.id here.
# KAFKA_CLUSTER_ID=...
BLOG_MONGO_DATABASE=blog
BLOG_MONGO_COMMAND_DATABASE=store
# Replay the complete original journal; enable only with compatible snapshots.
BLOG_PEKKO_SNAPSHOTS_ENABLED=false
BLOG_TITLE=Rapids Blog
# Local demo only: username == password. Disable for non-local use.
BLOG_AUTH_DEV_LOGIN=true
